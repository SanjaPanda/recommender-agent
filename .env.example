# Local development configuration. Copy to .env and replace the placeholder.
POSTGRES_DB=recommender_agent
POSTGRES_USER=recommender
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://recommender:replace-with-a-long-random-password@127.0.0.1:5432/recommender_agent

# Local Ollama language inference; no hosted API key is required.
OLLAMA_URL=http://127.0.0.1:11434
AGENT_MODEL=gemma3:4b
EMBEDDING_MODEL=nomic-embed-text
# Optional: CPU embedding inference when GPU offload is slower on this machine.
# EMBEDDING_NUM_GPU=0
IMAGE_EMBEDDING_MODEL=openai/clip-vit-base-patch32
# Disable reasoning traces for routine calls; model switches require live validation.
AGENT_THINK=false
# Optional: use CPU-only inference if partial GPU offload is slow.
# AGENT_NUM_GPU=0
# Cold Gemma model loads are slower than warm calls; the timeout covers one cold route.
AGENT_ROUTER_TIMEOUT_SECONDS=180
# Optional generated prose adds a model call (15-second network timeout).
# Default responses use catalogue counts without a summary call.
AGENT_GENERATE_SUMMARIES=false
