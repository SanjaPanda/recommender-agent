# Local development configuration. Copy to .env and replace the placeholder.
POSTGRES_DB=recommender_agent
POSTGRES_USER=recommender
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://recommender:replace-with-a-long-random-password@127.0.0.1:5432/recommender_agent

# Local Ollama language/vision inference; no hosted API key is required.
OLLAMA_URL=http://127.0.0.1:11434
AGENT_MODEL=gemma3:4b
AGENT_VISION_MODEL=gemma3:4b
